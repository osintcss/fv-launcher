{
  "name": "flash-player",
  "version": "1.0.0",
  "description": "Cross-platform Flash player using Pepper Flash",
  "main": "main.js",
  "scripts": {
    "download:plugins": "node scripts/download-plugins.js",
    "start": "electron .",
    "start:mac": "arch -x86_64 electron .",
    "build": "npm run download:plugins && electron-builder --publish never",
    "build:mac": "node scripts/download-plugins.js --platform darwin && electron-builder --mac --x64 --publish never",
    "build:win": "node scripts/download-plugins.js --platform win32 && electron-builder --win --publish never",
    "build:linux": "node scripts/download-plugins.js --platform linux && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.flash.player",
    "productName": "Flash Player",
    "icon": "logo.png",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "plugins/**/*"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "logo.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": "x64"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": "x64"
        }
      ],
      "icon": "logo.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": "x64"
        }
      ],
      "icon": "logo.png"
    }
  },
  "devDependencies": {
    "electron": "11.5.0",
    "electron-builder": "^22.14.13"
  }
}
